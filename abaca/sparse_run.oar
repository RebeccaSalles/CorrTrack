#!/bin/bash
# CorrTrack four-way comparison on SPARSE synthetic data (density-targeted generator,
# target_density ~2%), n_vectors=64 (the sweet spot found on the dense real dataset).
#
#OAR -n corrtrack-sparse
#OAR -l host=1,walltime=01:30:00
#OAR -O abaca/logs/OAR.%jobid%.out
#OAR -E abaca/logs/OAR.%jobid%.err

set -uo pipefail

CONDA_ROOT="${CONDA_ROOT:-$HOME/miniforge3}"
CONDA_ENV="${CONDA_ENV:-corrtrack}"
REPO_DIR="${REPO_DIR:-$HOME/corrtrack_release_dev}"
RESULTS_ROOT="${RESULTS_ROOT:-$HOME/corrtrack_abaca_results}"

RUN_DIR="$RESULTS_ROOT/sparse_${OAR_JOB_ID:-manual}"
mkdir -p "$RUN_DIR"

echo "== CorrTrack Abaca sparse-data four-way comparison =="
echo "job=${OAR_JOB_ID:-manual} host=$(hostname) date=$(date --iso-8601=seconds)"

# shellcheck disable=SC1091
source "$CONDA_ROOT/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export CORRTRACK_N_VECTORS_OVERRIDE=64
export SPARSE_TARGET_DENSITY=0.02

cd "$REPO_DIR"

echo "== build kernels (node-specific, -march=native) =="
rm -f ./*.cpython-*.so
rm -rf build
python setup_cython.py build_ext --inplace -j 4 2>&1 | tee "$RUN_DIR/build.log"
BUILD_RC=${PIPESTATUS[0]}
echo "build_rc=$BUILD_RC"

echo "== regression suite (synth generator tests too) =="
python -m pytest test_stable_reproduced_changes.py test_synth_density.py -q \
    2>&1 | tee "$RUN_DIR/pytest.log"
PYTEST_RC=${PIPESTATUS[0]}
echo "pytest_rc=$PYTEST_RC"

echo "== sparse four-way comparison =="
python "$REPO_DIR/abaca/sparse_fourway_compare.py" 2>&1 | tee "$RUN_DIR/sparse.log"
COMPARE_RC=${PIPESTATUS[0]}
echo "compare_rc=$COMPARE_RC"

echo "== summary =="
echo "build_rc=$BUILD_RC pytest_rc=$PYTEST_RC compare_rc=$COMPARE_RC"
echo "artifacts under $RUN_DIR"
