#!/bin/bash
# Generic wrapper for the side experiments (ablation ladder, parallel scaling, naive baseline, monitoring):
#   oarsub -q abaca -p "cluster='mercantour3'" -l host=1,walltime=12:00:00 -S "./abaca/experiment.oar SCRIPT=abaca/ablation_corrtrack.py ARGS=--dataset-config+experiment_dataset_sp500.py+--window-size+60+..."
# '+' in ARGS stands for a space. Output JSON goes to $RESULTS_ROOT/<script stem>_<jobid>/out.json unless ARGS has --out.
#
#OAR -n corrtrack-experiment
#OAR -q abaca
# (2026-09-19) no #OAR -l / -p here: a header -l plus a command-line -l makes a MOLDABLE job (OAR picks either;
# the Phase R reruns got the header's 12 h instead of the requested 24 h). Resources and host properties are
# given on the oarsub command line only, e.g. -p "cluster='mercantour3'" -l host=1,walltime=24:00:00
#OAR -O abaca/logs/OAR.%jobid%.out
#OAR -E abaca/logs/OAR.%jobid%.err
set -uo pipefail
for kv in "$@"; do export "${kv?}"; done
CONDA_ROOT="${CONDA_ROOT:-$HOME/miniforge3}"; CONDA_ENV="${CONDA_ENV:-corrtrack}"; REPO_DIR="${REPO_DIR:-$HOME/corrtrack_release_dev}"
RESULTS_ROOT="${RESULTS_ROOT:-$HOME/corrtrack_abaca_results}"
SCRIPT="${SCRIPT:?SCRIPT=abaca/<script>.py is required}"
ARGS="${ARGS:-}"; ARGS="${ARGS//+/ }"
STEM="$(basename "$SCRIPT" .py)_${OAR_JOB_ID:-manual}"
RUN_DIR="$RESULTS_ROOT/$STEM"; mkdir -p "$RUN_DIR"
echo "== $SCRIPT == job=${OAR_JOB_ID:-manual} host=$(hostname) date=$(date --iso-8601=seconds) args=[$ARGS]"
# shellcheck disable=SC1091
source "$CONDA_ROOT/etc/profile.d/conda.sh"; conda activate "$CONDA_ENV"
# BLAS pinned to one thread: parallel_scaling varies the harness threads only, everything else is single-threaded
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
cd "$REPO_DIR"; rm -f ./*.cpython-*.so; rm -rf build
python setup_cython.py build_ext --inplace -j 4 > "$RUN_DIR/build.log" 2>&1
case "$ARGS" in *--out*) OUT="";; *) OUT="--out $RUN_DIR/out.json";; esac
# shellcheck disable=SC2086
python "$SCRIPT" $ARGS $OUT 2>&1 | tee "$RUN_DIR/run.log"
echo "rc=${PIPESTATUS[0]} dir=$RUN_DIR"
