#!/bin/bash
# CorrTrack N-way competitor comparison on one competitor-paper dataset (phase 0f sets).
# Generalizes fourway_compare.oar: pick the dataset config and the protocol with env vars.
#
#   oarsub -S "./abaca/nway_compare.oar DATASET_CONFIG=experiment_dataset_motes_temperature.py N_LAGS=480 THR=0.9"
#
#OAR -n corrtrack-nway
#OAR -q abaca
#OAR -p cluster='mercantour3'
#OAR -l host=1,walltime=12:00:00
#OAR -O abaca/logs/OAR.%jobid%.out
#OAR -E abaca/logs/OAR.%jobid%.err

set -uo pipefail
# Parameters arrive as KEY=VALUE arguments (oarsub -S "./script.oar KEY=VALUE ..."): OAR does not
# propagate the submitter's environment to the node. Environment variables still work when the
# script is run by hand.
for kv in "$@"; do export "${kv?}"; done

CONDA_ROOT="${CONDA_ROOT:-$HOME/miniforge3}"
CONDA_ENV="${CONDA_ENV:-corrtrack}"
REPO_DIR="${REPO_DIR:-$HOME/corrtrack_release_dev}"
RESULTS_ROOT="${RESULTS_ROOT:-$HOME/corrtrack_abaca_results}"

DATASET_CONFIG="${DATASET_CONFIG:-experiment_dataset_motes_temperature.py}"
ARMS="${ARMS:-all}"
WINDOW_SIZE="${WINDOW_SIZE:-168}"
WINDOW_STEP="${WINDOW_STEP:-12}"
BASIC_WINDOW="${BASIC_WINDOW:-$WINDOW_STEP}"   # = step: ParCorr's structural constraint, applied to every arm
N_LAGS="${N_LAGS:-0}"
THR="${THR:-0.7}"
NEG_CORR_FLAG="${NEG_CORR_FLAG:-}"          # set to --neg-corr for the second labelled run
EXTRA_ARGS="${EXTRA_ARGS:-}"                # e.g. "--n-obs 20000 --set corrjoin_ks=14 --set corrjoin_ke=28"
COMPETITOR_PARAMS="${COMPETITOR_PARAMS:-}"  # dir with best_params_<arm>.json from tune_competitors.oar
BEST_PARAMS="${BEST_PARAMS:-}"              # CorrTrack's own best_params_corrtrack.json
HYPEROPT_DIR="${HYPEROPT_DIR:-}"            # or: the hyperopt_corrtrack.oar OUT_DIR to search for it
if [ -z "$BEST_PARAMS" ] && [ -n "$HYPEROPT_DIR" ]; then
  BEST_PARAMS=$(find "$HYPEROPT_DIR" -name best_params_corrtrack.json 2>/dev/null | head -1)
  echo "best_params from HYPEROPT_DIR: ${BEST_PARAMS:-NOT FOUND (CorrTrack will run UNTUNED and is not quotable)}"
fi

STEM="$(basename "$DATASET_CONFIG" .py)_W${WINDOW_SIZE}_s${WINDOW_STEP}_L${N_LAGS}_T${THR}${NEG_CORR_FLAG:+_neg}"
RUN_DIR="$RESULTS_ROOT/nway_${OAR_JOB_ID:-manual}_$STEM"
mkdir -p "$RUN_DIR"

echo "== CorrTrack Abaca N-way comparison =="
echo "job=${OAR_JOB_ID:-manual} host=$(hostname) date=$(date --iso-8601=seconds)"
echo "repo=$REPO_DIR env=$CONDA_ENV run_dir=$RUN_DIR dataset=$DATASET_CONFIG arms=$ARMS"

# shellcheck disable=SC1091
source "$CONDA_ROOT/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
cd "$REPO_DIR"

echo "== build kernels (node-specific, -march=native) =="
rm -f ./*.cpython-*.so; rm -rf build
python setup_cython.py build_ext --inplace -j 4 2>&1 | tee "$RUN_DIR/build.log"
BUILD_RC=${PIPESTATUS[0]}

echo "== regression suite =="
python -m pytest test_stable_reproduced_changes.py -q 2>&1 | tee "$RUN_DIR/pytest.log"
PYTEST_RC=${PIPESTATUS[0]}

echo "== N-way comparison =="
# shellcheck disable=SC2086
python abaca/nway_compare.py --dataset-config "$DATASET_CONFIG" --arms "$ARMS" \
  --window-size "$WINDOW_SIZE" --window-step "$WINDOW_STEP" --basic-window "$BASIC_WINDOW" --n-lags "$N_LAGS" --corr-threshold "$THR" \
  ${COMPETITOR_PARAMS:+--competitor-params "$COMPETITOR_PARAMS"} ${BEST_PARAMS:+--best-params "$BEST_PARAMS"} \
  $NEG_CORR_FLAG $EXTRA_ARGS --out "$RUN_DIR/nway.json" 2>&1 | tee "$RUN_DIR/nway.log"
COMPARE_RC=${PIPESTATUS[0]}

echo "== summary =="
echo "build_rc=$BUILD_RC pytest_rc=$PYTEST_RC compare_rc=$COMPARE_RC"
echo "artifacts under $RUN_DIR"
