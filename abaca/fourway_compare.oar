#!/bin/bash
# CorrTrack four-way comparison: bruteforce vs bf_incremental vs filcorr vs CorrTrack (main).
# Real fr_air_temperature_121_1 dataset, window_size=168/step=12/n_lags=168/thr=0.7.
#
# Submit from the Sophia frontend, from the CorrTrack working tree:
#   oarsub -S ./abaca/fourway_compare.oar
#
#OAR -n corrtrack-fourway
#OAR -p cluster='mercantour3'
#OAR -l host=1,walltime=02:00:00
#OAR -O abaca/logs/OAR.%jobid%.out
#OAR -E abaca/logs/OAR.%jobid%.err

set -uo pipefail

CONDA_ROOT="${CONDA_ROOT:-$HOME/miniforge3}"
CONDA_ENV="${CONDA_ENV:-corrtrack}"
REPO_DIR="${REPO_DIR:-$HOME/corrtrack_release_dev}"
RESULTS_ROOT="${RESULTS_ROOT:-$HOME/corrtrack_abaca_results}"

RUN_DIR="$RESULTS_ROOT/fourway_${OAR_JOB_ID:-manual}"
mkdir -p "$RUN_DIR"

echo "== CorrTrack Abaca four-way comparison =="
echo "job=${OAR_JOB_ID:-manual} host=$(hostname) date=$(date --iso-8601=seconds)"
echo "repo=$REPO_DIR  env=$CONDA_ENV  run_dir=$RUN_DIR"

# shellcheck disable=SC1091
source "$CONDA_ROOT/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"

# controlled thread environment -- exec="sequential" in the comparison script itself,
# so pin BLAS threads to 1 for a clean single-threaded comparison (matches the local
# methodology this mirrors).
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

cd "$REPO_DIR"

echo "== build kernels (node-specific, -march=native) =="
rm -f ./*.cpython-*.so
rm -rf build
python setup_cython.py build_ext --inplace -j 4 2>&1 | tee "$RUN_DIR/build.log"
BUILD_RC=${PIPESTATUS[0]}
echo "build_rc=$BUILD_RC"

echo "== regression suite =="
python -m pytest test_stable_reproduced_changes.py -q 2>&1 | tee "$RUN_DIR/pytest.log"
PYTEST_RC=${PIPESTATUS[0]}
echo "pytest_rc=$PYTEST_RC"

echo "== four-way comparison =="
python "$REPO_DIR/abaca/fourway_compare.py" 2>&1 | tee "$RUN_DIR/fourway.log"
COMPARE_RC=${PIPESTATUS[0]}
echo "compare_rc=$COMPARE_RC"

echo "== summary =="
echo "build_rc=$BUILD_RC pytest_rc=$PYTEST_RC compare_rc=$COMPARE_RC"
echo "artifacts under $RUN_DIR"
