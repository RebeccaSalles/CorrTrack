#!/bin/bash
# CSZ-protocol tuning of the pruning competitor arms on one dataset config (abaca/tune_competitors.py).
# Output dir is shared with the N-way run through COMPETITOR_PARAMS.
#
#   oarsub -S "./abaca/tune_competitors.oar DATASET_CONFIG=experiment_dataset_motes_temperature.py THR=0.9 OUT_DIR=$HOME/corrtrack_abaca_results/tuned/motes_T0.9"
#
#OAR -n corrtrack-tune
#OAR -p cluster='mercantour3'
#OAR -l host=1,walltime=12:00:00
#OAR -O abaca/logs/OAR.%jobid%.out
#OAR -E abaca/logs/OAR.%jobid%.err

set -uo pipefail
# Parameters arrive as KEY=VALUE arguments (oarsub -S "./script.oar KEY=VALUE ..."): OAR does not
# propagate the submitter's environment to the node. Environment variables still work when the
# script is run by hand.
for kv in "$@"; do export "${kv?}"; done
CONDA_ROOT="${CONDA_ROOT:-$HOME/miniforge3}"
CONDA_ENV="${CONDA_ENV:-corrtrack}"
REPO_DIR="${REPO_DIR:-$HOME/corrtrack_release_dev}"
DATASET_CONFIG="${DATASET_CONFIG:-experiment_dataset_motes_temperature.py}"
ARMS="${ARMS:-parcorr,csz,statstream,corrjoin}"
WINDOW_SIZE="${WINDOW_SIZE:-168}"
WINDOW_STEP="${WINDOW_STEP:-12}"
BASIC_WINDOW="${BASIC_WINDOW:-$WINDOW_STEP}"   # = step: ParCorr's structural constraint, applied to every arm
N_LAGS="${N_LAGS:-0}"
THR="${THR:-0.7}"
NEG_CORR_FLAG="${NEG_CORR_FLAG:-}"
CALIB_OBS="${CALIB_OBS:-5000}"
EXTRA_ARGS="${EXTRA_ARGS:-}"
OUT_DIR="${OUT_DIR:-$HOME/corrtrack_abaca_results/tuned/$(basename "$DATASET_CONFIG" .py)_W${WINDOW_SIZE}_s${WINDOW_STEP}_L${N_LAGS}_T${THR}${NEG_CORR_FLAG:+_neg}}"
mkdir -p "$OUT_DIR"

echo "== CorrTrack Abaca competitor tuning (CSZ protocol) =="
echo "job=${OAR_JOB_ID:-manual} host=$(hostname) date=$(date --iso-8601=seconds) dataset=$DATASET_CONFIG out=$OUT_DIR"
# shellcheck disable=SC1091
source "$CONDA_ROOT/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
cd "$REPO_DIR"
rm -f ./*.cpython-*.so; rm -rf build
python setup_cython.py build_ext --inplace -j 4 > "$OUT_DIR/build.log" 2>&1
# shellcheck disable=SC2086
python abaca/tune_competitors.py --dataset-config "$DATASET_CONFIG" --arms "$ARMS" \
  --window-size "$WINDOW_SIZE" --window-step "$WINDOW_STEP" --basic-window "$BASIC_WINDOW" --n-lags "$N_LAGS" --corr-threshold "$THR" \
  --calib-obs "$CALIB_OBS" $NEG_CORR_FLAG $EXTRA_ARGS --out-dir "$OUT_DIR" 2>&1 | tee "$OUT_DIR/tune.log"
echo "tune_rc=${PIPESTATUS[0]} out=$OUT_DIR"
