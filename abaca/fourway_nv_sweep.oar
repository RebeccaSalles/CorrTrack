#!/bin/bash
# CorrTrack n_vectors sweep (96, 128) on the SAME dense real dataset, reusing the
# hyperopt-tuned candidate_backend/occupancy from job 3095527, only n_vectors varies.
#
#OAR -n corrtrack-nv-sweep
#OAR -l host=1,walltime=01:30:00
#OAR -O abaca/logs/OAR.%jobid%.out
#OAR -E abaca/logs/OAR.%jobid%.err

set -uo pipefail

CONDA_ROOT="${CONDA_ROOT:-$HOME/miniforge3}"
CONDA_ENV="${CONDA_ENV:-corrtrack}"
REPO_DIR="${REPO_DIR:-$HOME/corrtrack_release_dev}"
RESULTS_ROOT="${RESULTS_ROOT:-$HOME/corrtrack_abaca_results}"

RUN_DIR="$RESULTS_ROOT/nv_sweep_${OAR_JOB_ID:-manual}"
mkdir -p "$RUN_DIR"

echo "== CorrTrack Abaca n_vectors sweep (96, 128) =="
echo "job=${OAR_JOB_ID:-manual} host=$(hostname) date=$(date --iso-8601=seconds)"

# shellcheck disable=SC1091
source "$CONDA_ROOT/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

cd "$REPO_DIR"

echo "== build kernels (node-specific, -march=native) =="
rm -f ./*.cpython-*.so
rm -rf build
python setup_cython.py build_ext --inplace -j 4 2>&1 | tee "$RUN_DIR/build.log"
BUILD_RC=${PIPESTATUS[0]}
echo "build_rc=$BUILD_RC"

for NV in 96 128; do
  echo "== four-way comparison (n_vectors=$NV) =="
  CORRTRACK_N_VECTORS_OVERRIDE=$NV python "$REPO_DIR/abaca/fourway_compare.py" \
      2>&1 | tee "$RUN_DIR/fourway_nv${NV}.log"
  echo "nv${NV}_rc=${PIPESTATUS[0]}"
done

echo "== summary =="
echo "build_rc=$BUILD_RC"
echo "artifacts under $RUN_DIR"
