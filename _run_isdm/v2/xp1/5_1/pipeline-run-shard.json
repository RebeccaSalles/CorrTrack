        "query_radius": 4,
        "backend": "sharded_vectorized"
      }
    },
    {
      "name": "corrtrack_bptree_median_phase_sharded_vect",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
        "index-backend": "bptree",
        "sketch_method": "median_phase",
