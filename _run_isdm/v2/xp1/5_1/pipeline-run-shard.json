        "query_radius": 4,
        "backend": "sharded_vectorized"
      }
    },
    {
      "name": "corrtrack_kdtree_fft_lowpass_sharded_vect",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
        "index-backend": "kdtree",
        "sketch_method": "fft_lowpass",
        "query_radius": 4,
        "backend": "sharded_vectorized"
      }
    },
    {
      "name": "corrtrack_grid_fft_lowpass_sharded_vect",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
        "index-backend": "grid",
        "sketch_method": "fft_lowpass",
        "backend": "sharded_vectorized"
      }
    },
    {
      "name": "corrtrack_bptree_sharded_cyth",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
        "index-backend": "bptree",
        "backend": "sharded_cython"
      }
    },
    {
      "name": "corrtrack_kdtree_sharded_cyth",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
        "index-backend": "kdtree",
