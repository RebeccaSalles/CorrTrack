    {
      "name": "corrtrack_grid_sharded_cyth",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
        "index-backend": "grid",
        "backend": "sharded_cython"
      }
    },
    {
      "name": "corrtrack_bst_sharded_cyth",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
        "index-backend": "bst",
        "backend": "sharded_cython"
      }
    },
    {
      "name": "corrtrack_octree_sharded_cyth",
      "mode": "corrtrack",
      "optimize": true,
      "params": {
