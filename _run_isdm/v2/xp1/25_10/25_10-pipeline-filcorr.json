        "filcorr_ft": 0.5,
        "filcorr_backend": "cython"
      }
    },
    {
      "name": "filcorr_band_cython",
      "mode": "filcorr",
      "params": {
        "filcorr_fs": 0.01,
        "filcorr_ft": 0.1,
        "filcorr_backend": "cython"
      }
    },
    {
      "name": "filcorr_full_python",
      "mode": "filcorr",
      "params": {
        "filcorr_fs": 0.0,
        "filcorr_ft": 0.5,
        "filcorr_backend": "python"
      }
    },
    {
      "name": "filcorr_band_python",
      "mode": "filcorr",
      "params": {
        "filcorr_fs": 0.01,
        "filcorr_ft": 0.1,
        "filcorr_backend": "python"
      }
    },
    {
      "name": "filcorr_full_vectorized",
      "mode": "filcorr",
      "params": {
        "filcorr_fs": 0.0,
        "filcorr_ft": 0.5,
        "filcorr_backend": "vectorized"
      }
    },
    {
      "name": "filcorr_band_vectorized",
      "mode": "filcorr",
      "params": {
        "filcorr_fs": 0.01,
        "filcorr_ft": 0.1,
        "filcorr_backend": "vectorized"
      }
    }
  ]
